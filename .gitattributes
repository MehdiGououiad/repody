# Normalize all text to LF in the repository; Git checks out native on Windows
# only where explicitly requested below.
* text=auto eol=lf

# Shell and container entrypoints must stay LF even on Windows checkouts.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.gguf binary
*.tgz binary

# Generated artifacts: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
backend/uv.lock linguist-generated=true -diff
lib/api/generated/** linguist-generated=true -diff
lib/api/openapi.json linguist-generated=true -diff
