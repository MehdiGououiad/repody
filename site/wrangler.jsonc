// repody.com: the static export in out/, served by Cloudflare Workers static assets.
// https://developers.cloudflare.com/workers/static-assets/routing/static-site-generation/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repody-site",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // Served on the apex only (www redirects to it at the zone); no duplicate workers.dev copy.
  "routes": [{ "pattern": "repody.com/*", "zone_name": "repody.com" }],
  "workers_dev": false,
  "preview_urls": false,
}
