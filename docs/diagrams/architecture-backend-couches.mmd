%% Couches backend + contextes bornés Repody
%% Éditable : Mermaid flowchart
%% Doc : CONTEXT.md · docs/BACKEND.md · ADR 003

flowchart TB
  subgraph Presentation["Couche présentation"]
    Next["Next.js App Router<br/>app/ · components/"]
    Proxy["proxy.ts<br/>Auth.js + Bearer vers /api/v1"]
    APIRouters["FastAPI routers<br/>api/workflows · runs · uploads<br/>platform · operator"]
  end

  subgraph Application["Couche application / services"]
    WFSvc["app/workflow/<br/>CRUD · deploy · API key"]
    RunEnq["app/run/enqueue.py<br/>admission · create Run"]
    Outbox["app/run/dispatch_outbox.py<br/>outbox Postgres"]
    Dispatch["app/run/dispatch.py<br/>Taskiq kiq"]
    RunProc["app/run/processor.py<br/>claim · recipe"]
    PlatformOrch["runtime/recipe.py<br/>execute_platform_run"]
    IdpRun["agents/idp/run.py<br/>execute_idp_run"]
    IdpCompose["agents/idp/compose.py<br/>compose_idp"]
    OpSvc["app/operator/<br/>diagnostics · warmup"]
  end

  subgraph Domaine["Domaine audit execution"]
    Domain["app/run/lifecycle.py<br/>entité · cycle de vie"]
    Events["Événements domaine<br/>RunQueued · Started<br/>Completed · Failed"]
  end

  subgraph Extraction["Extraction & catalogue"]
    Pipe["extraction/pipeline.py<br/>extract_document"]
    Catalog["catalog/registry.py<br/>repody:vlm"]
    VLM["extraction/vlm.py<br/>PDF→PNG→NuExtract"]
    Rules["rules/runner.py<br/>logic + LLM"]
  end

  subgraph Infra["Infrastructure"]
    DB["infra/db/ SQLAlchemy + Alembic"]
    Storage["infra/storage/ MinIO ou local"]
    Taskiq["taskiq/ broker Redis Streams<br/>queues extract | fast"]
    InfClient["inference/ clients OpenAI-compat"]
    Auth["infra/auth/ JWT · Casbin RBAC"]
  end

  Next --> Proxy --> APIRouters
  APIRouters --> WFSvc
  APIRouters --> RunEnq
  APIRouters --> Auth
  RunEnq --> Outbox --> Dispatch --> Taskiq
  Taskiq --> RunProc
  RunProc --> Domain
  RunProc --> PlatformOrch --> IdpRun --> IdpCompose
  IdpRun --> Pipe --> Catalog --> VLM --> InfClient
  IdpRun --> Rules
  RunProc --> Events
  IdpRun --> Storage
  RunEnq --> DB
  RunProc --> DB
  WFSvc --> DB
  APIRouters --> OpSvc

