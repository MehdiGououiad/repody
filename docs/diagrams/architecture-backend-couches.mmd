%% Repody — Backend layers + bounded contexts
%% Docs: CONTEXT.md · docs/DEVELOPMENT.md · ADR 003 / 006 / 007

flowchart TB
  subgraph Presentation["Presentation"]
    Next["Next.js App Router<br/>app/ · components/"]
    Proxy["proxy.ts<br/>Auth.js + Bearer → /api/v1"]
    APIRouters["FastAPI routers<br/>api/workflows · runs · uploads<br/>platform · operator"]
  end

  subgraph Application["Application / use cases"]
    WFSvc["app/workflow/<br/>CRUD · deploy · API key"]
    RunEnq["app/run/enqueue.py<br/>admission · create Run"]
    Outbox["app/run/dispatch_outbox.py<br/>Postgres outbox"]
    Dispatch["app/run/dispatch.py<br/>Taskiq kiq"]
    RunProc["app/run/processor.py<br/>claim · execute"]
    IdpRun["agents/idp/run.py<br/>execute_idp_run"]
    IdpCompose["agents/idp/compose.py<br/>compose_idp"]
    OpSvc["app/operator/<br/>diagnostics · warmup"]
  end

  subgraph Domaine["Audit execution domain"]
    Domain["app/run/lifecycle.py<br/>entity · lifecycle"]
    Events["Domain events<br/>RunQueued · Started<br/>Completed · Failed"]
  end

  subgraph Extraction["Extraction & catalog"]
    Pipe["extraction/pipeline.py<br/>extract_document"]
    Catalog["catalog/registry.py<br/>repody:vlm · paddleocr:qwen<br/>glm:qwen · cloud"]
    VLM["extraction/vlm.py + nuextract.py<br/>PDF→PNG→schema JSON"]
    Rules["rules/runner.py<br/>logic + optional LLM"]
  end

  subgraph Infra["Infrastructure"]
    DB["infra/db/ SQLAlchemy + Alembic"]
    Storage["infra/storage/ MinIO or S3"]
    Taskiq["taskiq/ Redis Streams<br/>queues extract | fast"]
    InfClient["inference/ OpenAI-compat clients"]
    Auth["infra/auth/ JWT · RBAC"]
  end

  Next --> Proxy --> APIRouters
  APIRouters --> WFSvc
  APIRouters --> RunEnq
  APIRouters --> Auth
  RunEnq --> Outbox --> Dispatch --> Taskiq
  Taskiq --> RunProc
  RunProc --> Domain
  RunProc --> IdpRun --> IdpCompose
  IdpRun --> Pipe --> Catalog --> VLM --> InfClient
  IdpRun --> Rules
  RunProc --> Events
  IdpRun --> Storage
  RunEnq --> DB
  RunProc --> DB
  WFSvc --> DB
  APIRouters --> OpSvc

