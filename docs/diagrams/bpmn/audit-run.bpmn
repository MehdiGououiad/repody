<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repody — Document audit run (same process local & prod)
  Open in: https://demo.bpmn.io  or Camunda Modeler
  Code: app/run/enqueue.py · processor.py · agents/idp · extraction · rules
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_AuditRun"
             targetNamespace="https://repody.local/bpmn"
             exporter="repody"
             exporterVersion="0.1.0">

  <collaboration id="Collaboration_AuditRun">
    <participant id="Participant_User" name="User / Integrator" processRef="Process_User"/>
    <participant id="Participant_Control" name="Control (API + UI proxy)" processRef="Process_Control"/>
    <participant id="Participant_Worker" name="Worker extract | fast" processRef="Process_Worker"/>
    <participant id="Participant_Inference" name="External VLM (host llama / cluster endpoint)" processRef="Process_Inference"/>
    <messageFlow id="MF_1" sourceRef="Task_ChooseFile" targetRef="Task_Presign"/>
    <messageFlow id="MF_2" sourceRef="Task_PutObject" targetRef="Task_Confirm"/>
    <messageFlow id="MF_3" sourceRef="Task_StartRun" targetRef="Task_Enqueue"/>
    <messageFlow id="MF_4" sourceRef="Task_Dispatch" targetRef="Task_Claim"/>
    <messageFlow id="MF_5" sourceRef="Task_CallVlm" targetRef="Task_Chat"/>
    <messageFlow id="MF_6" sourceRef="Task_Chat" targetRef="Task_ParseFields"/>
    <messageFlow id="MF_7" sourceRef="Task_FollowSse" targetRef="Task_PublishProgress"/>
  </collaboration>

  <!-- USER -->
  <process id="Process_User" name="User" isExecutable="false">
    <startEvent id="Start_User" name="Need audit"/>
    <sequenceFlow id="SU1" sourceRef="Start_User" targetRef="Task_ChooseFile"/>
    <task id="Task_ChooseFile" name="Select document(s)"/>
    <sequenceFlow id="SU2" sourceRef="Task_ChooseFile" targetRef="Task_PutObject"/>
    <task id="Task_PutObject" name="PUT file to presigned URL"/>
    <sequenceFlow id="SU3" sourceRef="Task_PutObject" targetRef="Task_StartRun"/>
    <task id="Task_StartRun" name="Start run (JWT test or API key)"/>
    <sequenceFlow id="SU4" sourceRef="Task_StartRun" targetRef="Task_FollowSse"/>
    <task id="Task_FollowSse" name="Follow SSE / poll run"/>
    <sequenceFlow id="SU5" sourceRef="Task_FollowSse" targetRef="Task_ViewReport"/>
    <task id="Task_ViewReport" name="View audit report"/>
    <sequenceFlow id="SU6" sourceRef="Task_ViewReport" targetRef="End_User"/>
    <endEvent id="End_User" name="Done"/>
  </process>

  <!-- CONTROL -->
  <process id="Process_Control" name="Control" isExecutable="false">
    <startEvent id="Start_Control" name="API request"/>
    <sequenceFlow id="SC1" sourceRef="Start_Control" targetRef="Task_Presign"/>
    <task id="Task_Presign" name="Presign upload + record intent"/>
    <sequenceFlow id="SC2" sourceRef="Task_Presign" targetRef="Task_Confirm"/>
    <task id="Task_Confirm" name="Confirm upload (HeadObject + MIME)"/>
    <sequenceFlow id="SC3" sourceRef="Task_Confirm" targetRef="Task_Enqueue"/>
    <task id="Task_Enqueue" name="Auth · rate limit · admission · classify pool"/>
    <sequenceFlow id="SC4" sourceRef="Task_Enqueue" targetRef="GW_Admit"/>
    <exclusiveGateway id="GW_Admit" name="Admitted?"/>
    <sequenceFlow id="SC5a" name="no" sourceRef="GW_Admit" targetRef="End_Reject">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">rejected</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SC5b" name="yes" sourceRef="GW_Admit" targetRef="Task_PersistRun"/>
    <task id="Task_PersistRun" name="INSERT Run queued + outbox"/>
    <sequenceFlow id="SC6" sourceRef="Task_PersistRun" targetRef="Task_Dispatch"/>
    <task id="Task_Dispatch" name="Dispatch Taskiq after commit"/>
    <sequenceFlow id="SC7" sourceRef="Task_Dispatch" targetRef="Task_PublishProgress"/>
    <task id="Task_PublishProgress" name="Bridge Redis progress → SSE"/>
    <sequenceFlow id="SC8" sourceRef="Task_PublishProgress" targetRef="End_ControlOk"/>
    <endEvent id="End_ControlOk" name="202 + report"/>
    <endEvent id="End_Reject" name="401/403/409/429/503"/>
  </process>

  <!-- WORKER -->
  <process id="Process_Worker" name="Worker" isExecutable="false">
    <startEvent id="Start_Worker" name="Taskiq message">
      <messageEventDefinition id="Msg_Taskiq"/>
    </startEvent>
    <sequenceFlow id="SW1" sourceRef="Start_Worker" targetRef="Task_Claim"/>
    <task id="Task_Claim" name="Claim run (CAS queued → running)"/>
    <sequenceFlow id="SW2" sourceRef="Task_Claim" targetRef="GW_Claim"/>
    <exclusiveGateway id="GW_Claim" name="Claimed?"/>
    <sequenceFlow id="SW3a" name="duplicate" sourceRef="GW_Claim" targetRef="End_Skip"/>
    <sequenceFlow id="SW3b" name="ok" sourceRef="GW_Claim" targetRef="Task_FetchDoc"/>
    <task id="Task_FetchDoc" name="Fetch object from MinIO/S3"/>
    <sequenceFlow id="SW4" sourceRef="Task_FetchDoc" targetRef="Task_CallVlm"/>
    <task id="Task_CallVlm" name="Render pages · catalog document model"/>
    <sequenceFlow id="SW5" sourceRef="Task_CallVlm" targetRef="Task_ParseFields"/>
    <task id="Task_ParseFields" name="Parse fields · persist ExtractedField"/>
    <sequenceFlow id="SW6" sourceRef="Task_ParseFields" targetRef="Task_Rules"/>
    <task id="Task_Rules" name="Logic rules (+ optional LLM rules)"/>
    <sequenceFlow id="SW7" sourceRef="Task_Rules" targetRef="GW_Outcome"/>
    <exclusiveGateway id="GW_Outcome" name="Outcome"/>
    <sequenceFlow id="SW8a" name="success" sourceRef="GW_Outcome" targetRef="End_Done"/>
    <sequenceFlow id="SW8b" name="failure" sourceRef="GW_Outcome" targetRef="End_Failed"/>
    <endEvent id="End_Done" name="Run done"/>
    <endEvent id="End_Failed" name="Run failed"/>
    <endEvent id="End_Skip" name="Ignore duplicate"/>
  </process>

  <!-- INFERENCE -->
  <process id="Process_Inference" name="Inference" isExecutable="false">
    <startEvent id="Start_Inf" name="Chat request"/>
    <sequenceFlow id="SI1" sourceRef="Start_Inf" targetRef="Task_Chat"/>
    <task id="Task_Chat" name="OpenAI-compatible chat.completions&#10;Local: host.docker.internal:8081&#10;Prod: AUDIT_LLAMACPP_BASE_URL"/>
    <sequenceFlow id="SI2" sourceRef="Task_Chat" targetRef="End_Inf"/>
    <endEvent id="End_Inf" name="JSON fields"/>
  </process>

  <!-- DIAGRAM -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_AuditRun">
      <bpmndi:BPMNShape id="Shape_PUser" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1100" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PControl" bpmnElement="Participant_Control" isHorizontal="true">
        <dc:Bounds x="120" y="260" width="1100" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PWorker" bpmnElement="Participant_Worker" isHorizontal="true">
        <dc:Bounds x="120" y="480" width="1100" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PInf" bpmnElement="Participant_Inference" isHorizontal="true">
        <dc:Bounds x="120" y="720" width="1100" height="120"/>
      </bpmndi:BPMNShape>

      <!-- User elements -->
      <bpmndi:BPMNShape id="S_Start_User" bpmnElement="Start_User"><dc:Bounds x="160" y="132" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ChooseFile" bpmnElement="Task_ChooseFile"><dc:Bounds x="230" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PutObject" bpmnElement="Task_PutObject"><dc:Bounds x="390" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_StartRun" bpmnElement="Task_StartRun"><dc:Bounds x="550" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_FollowSse" bpmnElement="Task_FollowSse"><dc:Bounds x="710" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ViewReport" bpmnElement="Task_ViewReport"><dc:Bounds x="870" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_User" bpmnElement="End_User"><dc:Bounds x="1040" y="132" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_SU1" bpmnElement="SU1"><di:waypoint x="196" y="150"/><di:waypoint x="230" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SU2" bpmnElement="SU2"><di:waypoint x="350" y="150"/><di:waypoint x="390" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SU3" bpmnElement="SU3"><di:waypoint x="510" y="150"/><di:waypoint x="550" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SU4" bpmnElement="SU4"><di:waypoint x="670" y="150"/><di:waypoint x="710" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SU5" bpmnElement="SU5"><di:waypoint x="830" y="150"/><di:waypoint x="870" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SU6" bpmnElement="SU6"><di:waypoint x="990" y="150"/><di:waypoint x="1040" y="150"/></bpmndi:BPMNEdge>

      <!-- Control -->
      <bpmndi:BPMNShape id="S_Start_Control" bpmnElement="Start_Control"><dc:Bounds x="160" y="322" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Presign" bpmnElement="Task_Presign"><dc:Bounds x="230" y="300" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Confirm" bpmnElement="Task_Confirm"><dc:Bounds x="390" y="300" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Enqueue" bpmnElement="Task_Enqueue"><dc:Bounds x="550" y="300" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Admit" bpmnElement="GW_Admit" isMarkerVisible="true"><dc:Bounds x="730" y="315" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PersistRun" bpmnElement="Task_PersistRun"><dc:Bounds x="820" y="300" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Dispatch" bpmnElement="Task_Dispatch"><dc:Bounds x="970" y="300" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PublishProgress" bpmnElement="Task_PublishProgress"><dc:Bounds x="970" y="400" width="120" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_ControlOk" bpmnElement="End_ControlOk"><dc:Bounds x="1140" y="322" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Reject" bpmnElement="End_Reject"><dc:Bounds x="737" y="390" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- Worker -->
      <bpmndi:BPMNShape id="S_Start_Worker" bpmnElement="Start_Worker"><dc:Bounds x="160" y="552" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Claim" bpmnElement="Task_Claim"><dc:Bounds x="230" y="530" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Claim" bpmnElement="GW_Claim" isMarkerVisible="true"><dc:Bounds x="390" y="545" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_FetchDoc" bpmnElement="Task_FetchDoc"><dc:Bounds x="480" y="530" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_CallVlm" bpmnElement="Task_CallVlm"><dc:Bounds x="640" y="530" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ParseFields" bpmnElement="Task_ParseFields"><dc:Bounds x="820" y="530" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Rules" bpmnElement="Task_Rules"><dc:Bounds x="980" y="530" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Outcome" bpmnElement="GW_Outcome" isMarkerVisible="true"><dc:Bounds x="1140" y="545" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Done" bpmnElement="End_Done"><dc:Bounds x="1147" y="620" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Failed" bpmnElement="End_Failed"><dc:Bounds x="1080" y="620" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Skip" bpmnElement="End_Skip"><dc:Bounds x="397" y="620" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- Inference -->
      <bpmndi:BPMNShape id="S_Start_Inf" bpmnElement="Start_Inf"><dc:Bounds x="640" y="762" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Chat" bpmnElement="Task_Chat"><dc:Bounds x="720" y="740" width="280" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Inf" bpmnElement="End_Inf"><dc:Bounds x="1040" y="762" width="36" height="36"/></bpmndi:BPMNShape>

      <!-- Message flows -->
      <bpmndi:BPMNEdge id="E_MF1" bpmnElement="MF_1"><di:waypoint x="290" y="190"/><di:waypoint x="290" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF2" bpmnElement="MF_2"><di:waypoint x="450" y="190"/><di:waypoint x="450" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF3" bpmnElement="MF_3"><di:waypoint x="610" y="190"/><di:waypoint x="620" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF4" bpmnElement="MF_4"><di:waypoint x="1030" y="380"/><di:waypoint x="1030" y="450"/><di:waypoint x="290" y="450"/><di:waypoint x="290" y="530"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF5" bpmnElement="MF_5"><di:waypoint x="710" y="610"/><di:waypoint x="710" y="740"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF6" bpmnElement="MF_6"><di:waypoint x="860" y="740"/><di:waypoint x="880" y="610"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MF7" bpmnElement="MF_7"><di:waypoint x="770" y="190"/><di:waypoint x="770" y="280"/><di:waypoint x="1030" y="280"/><di:waypoint x="1030" y="400"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
