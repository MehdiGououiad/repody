<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repody — Local development: start platform (laptop / Mac zip)
  Open: https://demo.bpmn.io  ·  Camunda Modeler
  Docs: docs/LOCAL.md
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_LocalStart"
             targetNamespace="https://repody.local/bpmn"
             exporter="repody"
             exporterVersion="0.1.0">

  <process id="Process_LocalStart" name="Local platform start" isExecutable="false">
    <laneSet id="LaneSet_Local">
      <lane id="Lane_Dev" name="Developer / Mac client">
        <flowNodeRef>Start_Local</flowNodeRef>
        <flowNodeRef>GW_Delivery</flowNodeRef>
        <flowNodeRef>Task_Unzip</flowNodeRef>
        <flowNodeRef>Task_GitSetup</flowNodeRef>
        <flowNodeRef>Task_EnvModels</flowNodeRef>
        <flowNodeRef>Task_Doctor</flowNodeRef>
        <flowNodeRef>GW_Doctor</flowNodeRef>
        <flowNodeRef>Task_FixPrereq</flowNodeRef>
        <flowNodeRef>Task_StartStack</flowNodeRef>
        <flowNodeRef>Task_Login</flowNodeRef>
        <flowNodeRef>End_Ready</flowNodeRef>
      </lane>
      <lane id="Lane_Host" name="Host metal">
        <flowNodeRef>Task_Llama</flowNodeRef>
      </lane>
      <lane id="Lane_Docker" name="Docker Compose (Hub images)">
        <flowNodeRef>Task_Pull</flowNodeRef>
        <flowNodeRef>Task_ComposeUp</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="Start_Local" name="Want local Repody"/>
    <sequenceFlow id="F1" sourceRef="Start_Local" targetRef="GW_Delivery"/>

    <exclusiveGateway id="GW_Delivery" name="How delivered?"/>
    <sequenceFlow id="F2a" name="Mac zip (no source)" sourceRef="GW_Delivery" targetRef="Task_Unzip"/>
    <sequenceFlow id="F2b" name="Git vendor checkout" sourceRef="GW_Delivery" targetRef="Task_GitSetup"/>

    <task id="Task_Unzip" name="unzip · chmod +x bin/repody · ./bin/repody setup"/>
    <sequenceFlow id="F3a" sourceRef="Task_Unzip" targetRef="Task_EnvModels"/>

    <task id="Task_GitSetup" name="pnpm install · pnpm platform setup"/>
    <sequenceFlow id="F3b" sourceRef="Task_GitSetup" targetRef="Task_EnvModels"/>

    <task id="Task_EnvModels" name="Set NuExtract GGUF paths&#10;(models/paths.env or deploy/llamacpp/paths.local.env)"/>
    <sequenceFlow id="F4" sourceRef="Task_EnvModels" targetRef="Task_Doctor"/>

    <task id="Task_Doctor" name="Preflight doctor&#10;(Docker · llama-server · GGUFs · images)"/>
    <sequenceFlow id="F5" sourceRef="Task_Doctor" targetRef="GW_Doctor"/>

    <exclusiveGateway id="GW_Doctor" name="Ready?"/>
    <sequenceFlow id="F6a" name="fail" sourceRef="GW_Doctor" targetRef="Task_FixPrereq"/>
    <sequenceFlow id="F6b" name="ok" sourceRef="GW_Doctor" targetRef="Task_Llama"/>

    <task id="Task_FixPrereq" name="Install Docker Desktop / brew llama.cpp / download GGUFs"/>
    <sequenceFlow id="F6c" sourceRef="Task_FixPrereq" targetRef="Task_Doctor"/>

    <serviceTask id="Task_Llama" name="Start llama-server :8081&#10;NuExtract (repody:vlm)"/>
    <sequenceFlow id="F7" sourceRef="Task_Llama" targetRef="Task_Pull"/>

    <serviceTask id="Task_Pull" name="docker pull&#10;repody-backend + repody-web"/>
    <sequenceFlow id="F8" sourceRef="Task_Pull" targetRef="Task_ComposeUp"/>

    <serviceTask id="Task_ComposeUp" name="Compose up&#10;api · web · workers · postgres · redis · minio · keycloak"/>
    <sequenceFlow id="F9" sourceRef="Task_ComposeUp" targetRef="Task_StartStack"/>

    <task id="Task_StartStack" name="./bin/repody start  or  pnpm platform"/>
    <sequenceFlow id="F10" sourceRef="Task_StartStack" targetRef="Task_Login"/>

    <task id="Task_Login" name="Open http://localhost:3000&#10;operator@repody.local / repody-dev"/>
    <sequenceFlow id="F11" sourceRef="Task_Login" targetRef="End_Ready"/>

    <endEvent id="End_Ready" name="Local platform ready"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Local">
    <bpmndi:BPMNPlane id="BPMNPlane_Local" bpmnElement="Process_LocalStart">
      <bpmndi:BPMNShape id="Lane_Dev_di" bpmnElement="Lane_Dev" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1280" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Host_di" bpmnElement="Lane_Host" isHorizontal="true">
        <dc:Bounds x="120" y="280" width="1280" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Docker_di" bpmnElement="Lane_Docker" isHorizontal="true">
        <dc:Bounds x="120" y="400" width="1280" height="140"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Local_di" bpmnElement="Start_Local">
        <dc:Bounds x="160" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Delivery_di" bpmnElement="GW_Delivery" isMarkerVisible="true">
        <dc:Bounds x="230" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Unzip_di" bpmnElement="Task_Unzip">
        <dc:Bounds x="320" y="100" width="160" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GitSetup_di" bpmnElement="Task_GitSetup">
        <dc:Bounds x="320" y="190" width="160" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnvModels_di" bpmnElement="Task_EnvModels">
        <dc:Bounds x="520" y="130" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Doctor_di" bpmnElement="Task_Doctor">
        <dc:Bounds x="720" y="130" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Doctor_di" bpmnElement="GW_Doctor" isMarkerVisible="true">
        <dc:Bounds x="910" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixPrereq_di" bpmnElement="Task_FixPrereq">
        <dc:Bounds x="860" y="220" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartStack_di" bpmnElement="Task_StartStack">
        <dc:Bounds x="1120" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="1290" y="130" width="90" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ready_di" bpmnElement="End_Ready">
        <dc:Bounds x="1410" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Llama_di" bpmnElement="Task_Llama">
        <dc:Bounds x="980" y="300" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pull_di" bpmnElement="Task_Pull">
        <dc:Bounds x="980" y="430" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComposeUp_di" bpmnElement="Task_ComposeUp">
        <dc:Bounds x="1180" y="430" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="196" y="170"/><di:waypoint x="230" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2a_di" bpmnElement="F2a"><di:waypoint x="255" y="145"/><di:waypoint x="255" y="135"/><di:waypoint x="320" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2b_di" bpmnElement="F2b"><di:waypoint x="255" y="195"/><di:waypoint x="255" y="225"/><di:waypoint x="320" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3a_di" bpmnElement="F3a"><di:waypoint x="480" y="135"/><di:waypoint x="500" y="135"/><di:waypoint x="500" y="170"/><di:waypoint x="520" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3b_di" bpmnElement="F3b"><di:waypoint x="480" y="225"/><di:waypoint x="500" y="225"/><di:waypoint x="500" y="170"/><di:waypoint x="520" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="680" y="170"/><di:waypoint x="720" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="870" y="170"/><di:waypoint x="910" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6a_di" bpmnElement="F6a"><di:waypoint x="935" y="195"/><di:waypoint x="935" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6c_di" bpmnElement="F6c"><di:waypoint x="860" y="245"/><di:waypoint x="795" y="245"/><di:waypoint x="795" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6b_di" bpmnElement="F6b"><di:waypoint x="935" y="195"/><di:waypoint x="935" y="340"/><di:waypoint x="980" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1070" y="380"/><di:waypoint x="1070" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1140" y="470"/><di:waypoint x="1180" y="470"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1270" y="430"/><di:waypoint x="1270" y="210"/><di:waypoint x="1260" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1260" y="170"/><di:waypoint x="1290" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1380" y="170"/><di:waypoint x="1410" y="170"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
