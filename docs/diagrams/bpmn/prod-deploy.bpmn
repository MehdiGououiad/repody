<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repody — Production: vendor release → client cluster deploy
  Open: https://demo.bpmn.io  ·  Camunda Modeler
  Docs: docs/CLUSTER.md · ADR 004 / 005
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_ProdDeploy"
             targetNamespace="https://repody.local/bpmn"
             exporter="repody"
             exporterVersion="0.1.0">

  <collaboration id="Collaboration_Prod">
    <participant id="Part_Vendor" name="Vendor" processRef="Process_Vendor"/>
    <participant id="Part_Client" name="Client platform team" processRef="Process_Client"/>
    <participant id="Part_Cluster" name="Kubernetes / OpenShift (namespace repody)" processRef="Process_Cluster"/>
    <messageFlow id="MF_Tag" sourceRef="Task_HandOff" targetRef="Task_Secrets"/>
    <messageFlow id="MF_Pull" sourceRef="Task_Helm" targetRef="Task_PullImages"/>
    <messageFlow id="MF_Ready" sourceRef="Task_Health" targetRef="Task_Smoke"/>
  </collaboration>

  <process id="Process_Vendor" name="Vendor" isExecutable="false">
    <startEvent id="Start_Vendor" name="Release cut"/>
    <sequenceFlow id="V1" sourceRef="Start_Vendor" targetRef="Task_BuildPush"/>
    <task id="Task_BuildPush" name="pnpm images:release&#10;repody-backend + repody-web&#10;(GHCR / Harbor / Hub)"/>
    <sequenceFlow id="V2" sourceRef="Task_BuildPush" targetRef="Task_Attest"/>
    <task id="Task_Attest" name="Optional: SBOM · cosign attest"/>
    <sequenceFlow id="V3" sourceRef="Task_Attest" targetRef="Task_HandOff"/>
    <task id="Task_HandOff" name="Hand off: registry · immutable tag ·&#10;Helm charts · client values templates&#10;(no application source)"/>
    <sequenceFlow id="V4" sourceRef="Task_HandOff" targetRef="End_Vendor"/>
    <endEvent id="End_Vendor" name="Client owns deploy"/>
  </process>

  <process id="Process_Client" name="Client" isExecutable="false">
    <startEvent id="Start_Client" name="Receive release package"/>
    <sequenceFlow id="C1" sourceRef="Start_Client" targetRef="Task_Secrets"/>
    <task id="Task_Secrets" name="Vault + ExternalSecrets&#10;runtime + registry-pull secrets"/>
    <sequenceFlow id="C2" sourceRef="Task_Secrets" targetRef="GW_Profile"/>
    <exclusiveGateway id="GW_Profile" name="Data profile?"/>
    <sequenceFlow id="C3a" name="bundled" sourceRef="GW_Profile" targetRef="Task_DataChart"/>
    <sequenceFlow id="C3b" name="external" sourceRef="GW_Profile" targetRef="Task_Helm"/>
    <task id="Task_DataChart" name="helm install repody-data&#10;(Postgres Redis MinIO)"/>
    <sequenceFlow id="C4" sourceRef="Task_DataChart" targetRef="Task_Helm"/>
    <task id="Task_Helm" name="helm install repody&#10;values → common → client → enterprise&#10;Ingress only (no Route CRs)"/>
    <sequenceFlow id="C5" sourceRef="Task_Helm" targetRef="Task_Smoke"/>
    <task id="Task_Smoke" name="Smoke: Ingress hosts · OIDC login ·&#10;healthz · sample run"/>
    <sequenceFlow id="C6" sourceRef="Task_Smoke" targetRef="End_Client"/>
    <endEvent id="End_Client" name="Production live"/>
  </process>

  <process id="Process_Cluster" name="Cluster" isExecutable="false">
    <startEvent id="Start_Cluster" name="Pull / schedule"/>
    <sequenceFlow id="K1" sourceRef="Start_Cluster" targetRef="Task_PullImages"/>
    <task id="Task_PullImages" name="Pull images into nodes"/>
    <sequenceFlow id="K2" sourceRef="Task_PullImages" targetRef="Task_Workloads"/>
    <task id="Task_Workloads" name="Run: web · api · worker-extract · worker-fast&#10;+ data plane per profile"/>
    <sequenceFlow id="K3" sourceRef="Task_Workloads" targetRef="Task_ExtDeps"/>
    <task id="Task_ExtDeps" name="Reach external OIDC IdP&#10;+ external VLM (AUDIT_LLAMACPP_BASE_URL)"/>
    <sequenceFlow id="K4" sourceRef="Task_ExtDeps" targetRef="Task_Health"/>
    <task id="Task_Health" name="/v1/healthz/live ready"/>
    <sequenceFlow id="K5" sourceRef="Task_Health" targetRef="End_Cluster"/>
    <endEvent id="End_Cluster" name="Serving traffic"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Prod">
    <bpmndi:BPMNPlane id="BPMNPlane_Prod" bpmnElement="Collaboration_Prod">
      <bpmndi:BPMNShape id="Part_Vendor_di" bpmnElement="Part_Vendor" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="1000" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Client_di" bpmnElement="Part_Client" isHorizontal="true">
        <dc:Bounds x="100" y="260" width="1000" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Cluster_di" bpmnElement="Part_Cluster" isHorizontal="true">
        <dc:Bounds x="100" y="480" width="1000" height="160"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Vendor_di" bpmnElement="Start_Vendor"><dc:Bounds x="140" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildPush_di" bpmnElement="Task_BuildPush"><dc:Bounds x="210" y="100" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Attest_di" bpmnElement="Task_Attest"><dc:Bounds x="410" y="100" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandOff_di" bpmnElement="Task_HandOff"><dc:Bounds x="590" y="100" width="200" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Vendor_di" bpmnElement="End_Vendor"><dc:Bounds x="830" y="122" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Client_di" bpmnElement="Start_Client"><dc:Bounds x="140" y="322" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Secrets_di" bpmnElement="Task_Secrets"><dc:Bounds x="210" y="300" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Profile_di" bpmnElement="GW_Profile" isMarkerVisible="true"><dc:Bounds x="410" y="315" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataChart_di" bpmnElement="Task_DataChart"><dc:Bounds x="500" y="360" width="150" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Helm_di" bpmnElement="Task_Helm"><dc:Bounds x="690" y="300" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Smoke_di" bpmnElement="Task_Smoke"><dc:Bounds x="910" y="300" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Client_di" bpmnElement="End_Client"><dc:Bounds x="1080" y="322" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Cluster_di" bpmnElement="Start_Cluster"><dc:Bounds x="210" y="542" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PullImages_di" bpmnElement="Task_PullImages"><dc:Bounds x="280" y="520" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Workloads_di" bpmnElement="Task_Workloads"><dc:Bounds x="460" y="520" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExtDeps_di" bpmnElement="Task_ExtDeps"><dc:Bounds x="680" y="520" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Health_di" bpmnElement="Task_Health"><dc:Bounds x="900" y="520" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cluster_di" bpmnElement="End_Cluster"><dc:Bounds x="1060" y="542" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="V1_di" bpmnElement="V1"><di:waypoint x="176" y="140"/><di:waypoint x="210" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="V2_di" bpmnElement="V2"><di:waypoint x="370" y="140"/><di:waypoint x="410" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="V3_di" bpmnElement="V3"><di:waypoint x="550" y="140"/><di:waypoint x="590" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="V4_di" bpmnElement="V4"><di:waypoint x="790" y="140"/><di:waypoint x="830" y="140"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="C1_di" bpmnElement="C1"><di:waypoint x="176" y="340"/><di:waypoint x="210" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C2_di" bpmnElement="C2"><di:waypoint x="370" y="340"/><di:waypoint x="410" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C3a_di" bpmnElement="C3a"><di:waypoint x="435" y="365"/><di:waypoint x="435" y="390"/><di:waypoint x="500" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C3b_di" bpmnElement="C3b"><di:waypoint x="460" y="340"/><di:waypoint x="690" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C4_di" bpmnElement="C4"><di:waypoint x="650" y="390"/><di:waypoint x="670" y="390"/><di:waypoint x="670" y="340"/><di:waypoint x="690" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C5_di" bpmnElement="C5"><di:waypoint x="870" y="340"/><di:waypoint x="910" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C6_di" bpmnElement="C6"><di:waypoint x="1050" y="340"/><di:waypoint x="1080" y="340"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="K1_di" bpmnElement="K1"><di:waypoint x="246" y="560"/><di:waypoint x="280" y="560"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K2_di" bpmnElement="K2"><di:waypoint x="420" y="560"/><di:waypoint x="460" y="560"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K3_di" bpmnElement="K3"><di:waypoint x="640" y="560"/><di:waypoint x="680" y="560"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K4_di" bpmnElement="K4"><di:waypoint x="860" y="560"/><di:waypoint x="900" y="560"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K5_di" bpmnElement="K5"><di:waypoint x="1020" y="560"/><di:waypoint x="1060" y="560"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_Tag_di" bpmnElement="MF_Tag"><di:waypoint x="690" y="180"/><di:waypoint x="290" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Pull_di" bpmnElement="MF_Pull"><di:waypoint x="780" y="380"/><di:waypoint x="780" y="450"/><di:waypoint x="350" y="450"/><di:waypoint x="350" y="520"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Ready_di" bpmnElement="MF_Ready"><di:waypoint x="960" y="520"/><di:waypoint x="960" y="380"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
