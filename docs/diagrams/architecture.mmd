%% Repody — Production architecture
%% Visual style adapted from layered cloud reference diagrams:
%%   Users → Edge → API → Event bus → Logic layer → Data layer
%% Stack: Next.js · FastAPI · RBAC · Taskiq · Redis/SSE · Postgres · MinIO · VLM
%% Docs: docs/CLUSTER.md · CONTEXT.md
%% Preview: https://mermaid.live

flowchart LR
  %% ═══════════════════════════════════════════════════════
  %% LEFT — actors & identity
  %% ═══════════════════════════════════════════════════════
  subgraph ACTORS[" "]
    direction TB
    User(["Users"])
    Admin(["Admins"])
  end

  IdP["Identity<br/><b>OIDC IdP</b><br/><i>Keycloak / client IdP</i>"]

  %% ═══════════════════════════════════════════════════════
  %% EDGE — routing into the platform
  %% ═══════════════════════════════════════════════════════
  subgraph EDGE["Edge routing"]
    direction TB
    Ing["Ingress<br/><b>networking.k8s.io</b><br/><i>web · api · files hosts</i>"]
    FE["Frontend<br/><b>Next.js · Auth.js</b><br/><i>repody-web</i>"]
  end

  %% ═══════════════════════════════════════════════════════
  %% API — sync entry + authz
  %% ═══════════════════════════════════════════════════════
  subgraph APILAYER["API layer"]
    direction TB
    API["API<br/><b>FastAPI</b><br/><i>repody-api</i><br/>workflows · uploads · runs"]
    RBAC["Authorization<br/><b>RBAC</b><br/><i>viewer · operator · admin</i>"]
    SSE["Live updates<br/><b>SSE streams</b><br/><i>/runs/id/events</i>"]
    API --- RBAC
    API --- SSE
  end

  %% ═══════════════════════════════════════════════════════
  %% ASYNC BUS — like EventBridge in the reference
  %% ═══════════════════════════════════════════════════════
  Bus["Event / job bus<br/><b>Redis</b><br/><i>Taskiq Streams + pub/sub</i>"]

  %% ═══════════════════════════════════════════════════════
  %% RIGHT — production cluster (dashed region style)
  %% ═══════════════════════════════════════════════════════
  subgraph REGION["Production — Kubernetes / OpenShift · namespace repody"]
    direction TB

    subgraph LOGIC["Logic layer — compute"]
      direction LR
      WX["Background jobs<br/><b>Taskiq worker</b><br/><i>pool extract</i><br/>PDF / document extract"]
      WF["Background jobs<br/><b>Taskiq worker</b><br/><i>pool fast</i><br/>logic-only runs"]
      VLM["Machine learning<br/><b>Inference VLM</b><br/><i>NuExtract · OpenAI API</i><br/>external to chart"]
    end

    subgraph DATA["Data layer — persistence"]
      direction LR
      PG[("Operational DB<br/><b>PostgreSQL</b><br/><i>workflows · runs · outbox<br/>fields · rules</i>")]
      MinIO[("Object storage<br/><b>MinIO / S3</b><br/><i>audit-documents</i>")]
    end
  end

  %% Ops (side)
  Vault["Secrets<br/><b>Vault + ESO</b>"]
  Registry["Images<br/><b>GHCR / Harbor</b>"]

  %% ═══════════════════════════════════════════════════════
  %% FLOWS — labeled like the reference diagram
  %% ═══════════════════════════════════════════════════════

  %% Sync user path
  User -->|"HTTPS"| Ing
  Admin -->|"HTTPS"| Ing
  User -->|"OIDC login"| IdP
  Ing -->|"UI"| FE
  FE -->|"OIDC"| IdP
  FE -->|"HTTPS + JWT<br/>commands / queries"| API
  API -->|"JWKS"| IdP
  API -->|"authorize"| RBAC

  %% Sync reads/writes from API
  API -->|"SQL sync"| PG
  API -->|"presign / confirm"| MinIO
  Ing -->|"files host"| MinIO

  %% Async write path (CQRS-style)
  API -->|"async enqueue<br/>outbox → job"| Bus
  Bus -->|"queue extract"| WX
  Bus -->|"queue fast"| WF
  WX -->|"GET object"| MinIO
  WX -->|"chat.completions"| VLM
  WX -->|"persist results"| PG
  WF -->|"persist results"| PG
  WX -->|"logic / progress events"| Bus
  WF -->|"progress events"| Bus

  %% Live path back to users (SSE)
  Bus -->|"pub/sub"| SSE
  SSE -->|"SSE stream"| FE
  FE -->|"live progress"| User

  %% Platform
  Vault -.->|"inject secrets"| API
  Vault -.->|"inject secrets"| WX
  Registry -.->|"pull images"| FE
  Registry -.->|"pull images"| API
  Registry -.->|"pull images"| WX

  %% ═══════════════════════════════════════════════════════
  %% STYLES — clean layered look
  %% ═══════════════════════════════════════════════════════
  classDef person fill:#ffffff,stroke:#374151,stroke-width:2px,color:#111827
  classDef edge fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef api fill:#e0e7ff,stroke:#4338ca,stroke-width:1.5px,color:#312e81
  classDef bus fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e
  classDef logic fill:#d1fae5,stroke:#059669,stroke-width:1.5px,color:#064e3b
  classDef data fill:#f3f4f6,stroke:#4b5563,stroke-width:1.5px,color:#111827
  classDef ext fill:#ffe4e6,stroke:#e11d48,stroke-width:1.5px,color:#9f1239
  classDef ops fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#5b21b6

  class User,Admin person
  class Ing,FE edge
  class API,RBAC,SSE api
  class Bus bus
  class WX,WF,VLM logic
  class PG,MinIO data
  class IdP,Vault,Registry ext

  style ACTORS fill:transparent,stroke:transparent
  style EDGE fill:#eff6ff,stroke:#93c5fd,stroke-dasharray:0,color:#1e3a8a
  style APILAYER fill:#eef2ff,stroke:#a5b4fc,color:#312e81
  style REGION fill:#f8fafc,stroke:#3b82f6,stroke-dasharray:6 4,color:#1e3a8a
  style LOGIC fill:#ecfdf5,stroke:#6ee7b7,color:#064e3b
  style DATA fill:#f9fafb,stroke:#9ca3af,color:#111827
