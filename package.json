{
  "name": "repody",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/MehdiGououiad/repody.git"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "doctor": "node scripts/check-toolchain.mjs",
    "platform": "node deploy/scripts/platform-dev.mjs",
    "ui": "next dev",
    "build": "next build",
    "codegen:api": "pnpm codegen:api:export && pnpm codegen:api:types",
    "codegen:api:export": "uv run --directory backend python scripts/export_openapi.py",
    "codegen:api:types": "openapi-typescript lib/api/openapi.json -o lib/api/generated/schema.d.ts",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "format": "biome check --write . && uv run --directory backend --extra dev --extra otel ruff format src tests scripts",
    "lint": "biome ci . && eslint app components lib proxy.ts",
    "lint:fix": "biome check --write . && eslint --fix app components lib proxy.ts",
    "lint:py": "uv run --directory backend --extra dev --extra otel ruff format --check src tests scripts && uv run --directory backend --extra dev --extra otel ruff check src tests scripts && uv run --directory backend --extra dev lint-imports",
    "lint:py:fix": "uv run --directory backend --extra dev --extra otel ruff check --fix src tests scripts && uv run --directory backend --extra dev --extra otel ruff format src tests scripts",
    "typecheck": "tsc --noEmit",
    "typecheck:py": "uv run --directory backend --extra dev --extra otel pyright",
    "deadcode": "knip",
    "verify": "pnpm lint && pnpm typecheck && pnpm deadcode && pnpm lint:py && pnpm typecheck:py",
    "review:check": "pnpm verify && pnpm test:api && pnpm deploy:check",
    "review:check:fast": "pnpm lint && pnpm typecheck && pnpm test:api",
    "architecture:check": "uv run --directory backend --extra dev lint-imports",
    "test:unit": "uv run --directory backend --extra dev pytest tests/unit -q",
    "test:integration": "uv run --directory backend --extra dev pytest tests/integration -q",
    "test:api": "uv run --directory backend --extra dev pytest -q",
    "test:live": "uv run --directory backend --extra dev pytest tests/live -m live -s",
    "db:migrate": "uv run --directory backend alembic upgrade head",
    "db:reset": "uv run --directory backend python scripts/db_reset.py",
    "client:pack:mac": "node deploy/scripts/pack-mac-runtime.mjs",
    "deploy:check": "node deploy/scripts/deploy-check.mjs",
    "images:build": "docker buildx bake -f docker-bake.hcl --load",
    "images:release": "docker buildx bake -f docker-bake.hcl --push",
    "helm:lint": "helm lint deploy/helm/repody -f deploy/helm/repody/values-production.yaml.example",
    "helm:template": "helm template repody deploy/helm/repody",
    "llamacpp:serve": "node deploy/scripts/llama-serve.mjs serve",
    "llamacpp:stop": "node deploy/scripts/llama-serve.mjs stop",
    "llamacpp:restart": "node deploy/scripts/llama-serve.mjs restart",
    "llamacpp:verify": "node deploy/scripts/llama-serve.mjs verify",
    "lightonocr:serve": "node deploy/scripts/llama-serve.mjs serve lightonocr",
    "lightonocr:stop": "node deploy/scripts/llama-serve.mjs stop lightonocr",
    "lightonocr:verify": "node deploy/scripts/llama-serve.mjs verify lightonocr",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/tests/01-platform-smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:platform": "node scripts/run-platform-e2e.mjs",
    "security:scan": "trivy fs --config deploy/security/trivy.yaml --scanners vuln,secret,misconfig ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "6.2.15",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "knip": "6.44.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
