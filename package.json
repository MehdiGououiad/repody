{
  "name": "repody",
  "version": "1.0.0",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MehdiGououiad/repody.git"
  },
  "workspaces": [
    "."
  ],
  "scripts": {
    "doctor": "node scripts/check-toolchain.mjs",
    "platform": "node deploy/scripts/platform-dev.mjs",
    "ui": "next dev",
    "build": "next build",
    "codegen:api": "bun run codegen:api:export && bun run codegen:api:types",
    "codegen:api:export": "uv run --directory backend python scripts/export_openapi.py",
    "codegen:api:types": "openapi-typescript lib/api/openapi.json -o lib/api/generated/schema.d.ts",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "fmt": "oxfmt",
    "format": "oxfmt && uv run --directory backend --extra otel ruff format src tests scripts alembic",
    "lint": "oxlint --report-unused-disable-directives-severity=error && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:py": "uv run --directory backend --extra otel ruff format --check src tests scripts alembic && uv run --directory backend --extra otel ruff check src tests scripts alembic && uv run --directory backend lint-imports",
    "lint:py:fix": "uv run --directory backend --extra otel ruff check --fix src tests scripts alembic && uv run --directory backend --extra otel ruff format src tests scripts alembic",
    "check": "tsc --noEmit",
    "typecheck:py": "uv run --directory backend --extra otel pyright",
    "deadcode": "knip",
    "verify": "bun lint && bun check && bun test && bun run deadcode && bun run lint:py && bun run typecheck:py",
    "review:check": "bun run verify && bun run test:api && bun run deploy:check",
    "review:check:fast": "bun lint && bun check && bun run test:api",
    "architecture:check": "uv run --directory backend lint-imports",
    "test:unit": "uv run --directory backend pytest tests/unit -q",
    "test:integration": "uv run --directory backend pytest tests/integration -q",
    "test:api": "uv run --directory backend pytest -q",
    "test:live": "uv run --directory backend pytest tests/live -m live -s",
    "db:migrate": "uv run --directory backend alembic upgrade head",
    "db:reset": "uv run --directory backend python scripts/db_reset.py",
    "deploy:check": "node deploy/scripts/deploy-check.mjs",
    "images:build": "docker buildx bake -f docker-bake.hcl --load",
    "images:release": "docker buildx bake -f docker-bake.hcl --push",
    "helm:lint": "helm lint deploy/helm/repody -f deploy/helm/repody/values-production.yaml.example",
    "helm:template": "helm template repody deploy/helm/repody",
    "llamacpp:serve": "node deploy/scripts/llama-serve.mjs serve",
    "llamacpp:stop": "node deploy/scripts/llama-serve.mjs stop",
    "llamacpp:restart": "node deploy/scripts/llama-serve.mjs restart",
    "llamacpp:verify": "node deploy/scripts/llama-serve.mjs verify",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/tests/00-auth.spec.ts e2e/tests/01-navigation.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:platform": "node scripts/run-platform-e2e.mjs",
    "security:scan": "trivy fs --config deploy/security/trivy.yaml --scanners vuln,secret,misconfig ."
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.10.1",
    "@sentry/nextjs": "^11.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dequal": "^2.0.3",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "negotiator": "^1.1.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/culori": "^4.0.1",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bun-types": "1.4.4",
    "knip": "6.45.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.15",
    "postcss-selector-parser": "^6.1.5"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "bun@1.4.4"
}
