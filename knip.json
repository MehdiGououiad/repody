{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,error,global-error,not-found,route,default,template,loading}.tsx",
    "app/**/route.ts",
    "app/actions/*.ts",
    "auth.ts",
    "proxy.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "e2e/**/*.spec.ts",
    "e2e/helpers/*.mjs",
    "scripts/*.mjs",
    "deploy/scripts/**/*.mjs"
  ],
  "project": ["**/*.{ts,tsx,mjs}"],
  "ignore": [
    "lib/api/generated/**",
    "next-env.d.ts",
    ".agents/**",
    "deploy/helm/**",
    "components/ui/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss",
    "@fontsource-variable/source-sans-3",
    "@fontsource-variable/jetbrains-mono"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["helm", "kubectl", "trivy", "where.exe"]
}
