{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,error,global-error,not-found,route,default,template,loading}.tsx",
    "app/**/route.ts",
    "app/actions/*.ts",
    "e2e/**/*.spec.ts",
    "e2e/*.setup.ts",
    "**/*.test.ts",
    "e2e/helpers/*.mjs",
    "scripts/*.mjs",
    "deploy/scripts/**/*.mjs"
  ],
  "project": ["**/*.{ts,tsx,mjs,css}"],
  "ignore": ["components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["helm", "tasklist", "trivy", "uv"]
}
