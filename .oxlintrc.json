{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint's correctness rules, with the plugins for this stack (React, Next.js, accessibility),
  // and the house rules: each one was set on purpose before (Biome, eslint-config-next).
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "controlComponents": ["Input", "Select", "Textarea"] }
    ],
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-unused-private-class-members": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/prefer-function-type": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      // Scripts print to the terminal.
      "files": ["deploy/scripts/**", "scripts/**", "e2e/**", "*.config.*"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["modules/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/idp",
                  "@/modules/idp/**",
                  "../idp",
                  "../idp/**",
                  "@/modules/fraud",
                  "@/modules/fraud/**",
                  "../fraud",
                  "../fraud/**",
                  "@/modules/pipelines",
                  "@/modules/pipelines/**",
                  "../pipelines",
                  "../pipelines/**",
                  "@/modules/operator",
                  "@/modules/operator/**",
                  "../operator",
                  "../operator/**"
                ],
                "message": "modules/core cannot import feature modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["modules/idp/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/fraud",
                  "@/modules/fraud/**",
                  "../fraud",
                  "../fraud/**",
                  "@/modules/pipelines",
                  "@/modules/pipelines/**",
                  "../pipelines",
                  "../pipelines/**",
                  "@/modules/operator",
                  "@/modules/operator/**",
                  "../operator",
                  "../operator/**"
                ],
                "message": "modules/idp must stay isolated from other feature modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["modules/fraud/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/idp",
                  "@/modules/idp/**",
                  "../idp",
                  "../idp/**",
                  "@/modules/pipelines",
                  "@/modules/pipelines/**",
                  "../pipelines",
                  "../pipelines/**",
                  "@/modules/operator",
                  "@/modules/operator/**",
                  "../operator",
                  "../operator/**"
                ],
                "message": "modules/fraud must stay isolated from other feature modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["modules/operator/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/idp",
                  "@/modules/idp/**",
                  "../idp",
                  "../idp/**",
                  "@/modules/fraud",
                  "@/modules/fraud/**",
                  "../fraud",
                  "../fraud/**",
                  "@/modules/pipelines",
                  "@/modules/pipelines/**",
                  "../pipelines",
                  "../pipelines/**"
                ],
                "message": "modules/operator must stay isolated from other feature modules."
              }
            ]
          }
        ]
      }
    }
  ]
}
