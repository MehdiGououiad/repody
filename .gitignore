# https://git-scm.com/docs/gitignore

# dependencies
/node_modules

# testing
/coverage
/e2e/report/
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build
/dist/
/backend/dist/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# debug
npm-debug.log*
*.log
/logs/
/.logs/

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.pytest_cache/
.ruff_cache/
/backend/.agents/
deploy/llamacpp/paths.local.env
deploy/llamacpp/models/
deploy/llamacpp/logs/
backend/.venv/
*.tgz

# local assistant tooling
/.claude/*
!/.claude/skills/
/.agents/
/skills-lock.json
/CLAUDE.md

# local-only benchmark material
/private/
/benchmark-reports/
# Real documents supplied for the OCR benchmark (benchmarks/ocr/real_docs.py): never committed.
/e2e/fixtures/documents/espace-transit-facture.*

# repody.com: its own project (dependencies, build, synced files)
/site/node_modules/
/site/out/
/site/.next/
/site/lib/shared/
