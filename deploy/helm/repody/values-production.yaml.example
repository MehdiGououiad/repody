# Production overlay: copy, fill in, and pass with `-f`. Chart defaults live in values.yaml.
#
#   helm upgrade --install repody deploy/helm/repody -n repody -f values-production.yaml
#
# The Secret named by existingSecret must exist first (External Secrets / Vault / SOPS) with:
#   AUDIT_DATABASE_URL       postgresql+asyncpg://repody:…@postgres-rw.db.svc:5432/repody
#   AUDIT_REDIS_URL          redis://…@redis.cache.svc:6379/0
#   AUDIT_S3_ACCESS_KEY      AUDIT_S3_SECRET_KEY
#   AUTH_SECRET              (openssl rand -base64 32)
#   AUTH_KEYCLOAK_CLIENT_SECRET
#   AUDIT_LLAMACPP_API_KEY   (optional, when the inference endpoint needs a bearer token)
#   BUGSINK_DSN              (optional)

images:
  backend:
    repository: registry.example.com/repody/repody-backend
    tag: "1.0.0"
    digest: ""          # sha256:… from `pnpm images:release`
  web:
    repository: registry.example.com/repody/repody-web
    tag: "1.0.0"
    digest: ""

imagePullSecrets:
  - name: registry-pull

existingSecret: repody-runtime-secrets

config:
  AUDIT_DEPLOYMENT_ENVIRONMENT: production
  AUDIT_OIDC_ENABLED: "true"
  AUDIT_OIDC_ISSUER: https://auth.example.com/realms/repody
  AUDIT_OIDC_AUDIENCE: repody-api
  AUDIT_S3_ENDPOINT_URL: https://s3.example.com
  AUDIT_S3_BUCKET: audit-documents
  AUDIT_LLAMACPP_BASE_URL: https://vlm.example.com/v1
  AUDIT_LLAMACPP_SERVED_MODEL: nuextract3-q8_0
  AUDIT_INFERENCE_TIMEOUT_SECONDS: "180"
  AUDIT_RUN_TIMEOUT_MINUTES: "5"
  AUDIT_CORS_ORIGINS: https://app.example.com
  AUDIT_LOG_JSON: "true"
  # OpenTelemetry agent (standard OTEL_* variables):
  # OTEL_SDK_DISABLED: "false"
  # OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector.observability.svc:4318

web:
  keycloakClientId: repody-web
  # Set when pods cannot reach the public issuer (split-horizon DNS, private Keycloak).
  internalIssuer: ""

ingress:
  className: nginx          # or openshift-default
  host: app.example.com
  apiHost: api.example.com
  tls:
    enabled: true
    secretName: repody-tls

networkPolicy:
  enabled: true
  egressCidrs:
    - 10.0.0.0/8            # database, Redis, S3, Keycloak, inference
