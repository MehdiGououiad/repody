# Copy to deploy/research/qwen35/paths.local.env (not committed).
# Then: node deploy/scripts/research/qwen35-serve.mjs serve
#        node deploy/scripts/research/qwen35-serve.mjs verify
#
# Model: https://huggingface.co/unsloth/Qwen3.5-4B-GGUF
# Prefer Q4_K_M on shared iGPU; raise quant if you have headroom.

QWEN35_EXE=
# Default: HF auto-download (llama-server -hf unsloth/Qwen3.5-4B-GGUF)
# QWEN35_USE_HF=true
# QWEN35_MODEL=C:\path\to\Qwen3.5-4B-Q4_K_M.gguf
# Optional file filter when using -hf (llama-server --hf-file):
# QWEN35_HF_FILE=Qwen3.5-4B-Q4_K_M.gguf
QWEN35_MODEL_ALIAS=Qwen3.5-4B

QWEN35_PORT=8084
QWEN35_CONTEXT=8192
QWEN35_GPU_LAYERS=99
# QWEN35_DEVICE=Vulkan0
QWEN35_PARALLEL=1
