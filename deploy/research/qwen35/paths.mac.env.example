# macOS Metal defaults — copy to deploy/research/qwen35/paths.local.env
# Install once: brew install llama.cpp
# Auto-downloads GGUF on first serve (llama-server -hf).

QWEN35_EXE=
# Empty MODEL → Hugging Face auto-download
QWEN35_USE_HF=true
QWEN35_HF_FILE=Qwen3.5-4B-Q4_K_M.gguf
QWEN35_MODEL_ALIAS=Qwen3.5-4B

QWEN35_PORT=8084
QWEN35_CONTEXT=8192
QWEN35_GPU_LAYERS=99
# Leave empty — Metal on Apple Silicon
QWEN35_DEVICE=
QWEN35_PARALLEL=1
