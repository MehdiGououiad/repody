# Copy to deploy/research/nuextract2/paths.local.env (not committed).
# Then: node deploy/scripts/research/nuextract2-serve.mjs serve
#
# Model: https://huggingface.co/numind/NuExtract-2.0-2B-GGUF

NUEXTRACT2_EXE=
# Default: HF auto-download
# NUEXTRACT2_USE_HF=true
# NUEXTRACT2_MODEL=C:\path\to\NuExtract-2.0-2B-Q8_0.gguf
# NUEXTRACT2_MMPROJ=C:\path\to\mmproj-BF16.gguf
NUEXTRACT2_MODEL_ALIAS=NuExtract-2.0-2B

NUEXTRACT2_PORT=8085
NUEXTRACT2_CONTEXT=8192
NUEXTRACT2_GPU_LAYERS=99
# NUEXTRACT2_DEVICE=Vulkan0
NUEXTRACT2_PARALLEL=1
