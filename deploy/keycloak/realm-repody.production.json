{
  "realm": "repody",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "platform_admin"
      },
      {
        "name": "admin"
      },
      {
        "name": "operator"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "repody-web",
      "name": "Repody Web",
      "enabled": true,
      "publicClient": false,
      "secret": "${AUTH_KEYCLOAK_CLIENT_SECRET}",
      "rootUrl": "${REPODY_APP_URL}",
      "redirectUris": ["${REPODY_APP_URL}/api/auth/callback/keycloak"],
      "webOrigins": ["${REPODY_APP_URL}"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "repody-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "repody-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${REPODY_APP_URL}/*"
      }
    },
    {
      "clientId": "repody-api",
      "name": "Repody API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "repody-admin",
      "name": "Repody admin area",
      "description": "Service account the Repody API uses to manage client groups and their users.",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["roles", "kc-admin-api"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "${REPODY_ADMIN_EMAIL}",
      "email": "${REPODY_ADMIN_EMAIL}",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "${REPODY_ADMIN_INITIAL_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["platform_admin"]
    },
    {
      "username": "service-account-repody-admin",
      "enabled": true,
      "serviceAccountClientId": "repody-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "repody-web",
      "roles": ["platform_admin", "admin", "operator", "viewer"]
    }
  ],
  "passwordPolicy": "length(12) and notUsername and passwordHistory(3)",
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "repody-admin",
        "roles": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    ]
  }
}
