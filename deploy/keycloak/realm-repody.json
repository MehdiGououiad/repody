{
  "realm": "repody",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "platform_admin"
      },
      {
        "name": "admin"
      },
      {
        "name": "operator"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "repody-web",
      "name": "Repody Web",
      "enabled": true,
      "publicClient": false,
      "secret": "repody-web-dev-secret",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://127.0.0.1:3000/api/auth/callback/keycloak",
        "http://app.repody.local/api/auth/callback/keycloak"
      ],
      "webOrigins": ["+"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "repody-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "repody-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "repody-e2e",
      "name": "Repody end-to-end tests",
      "description": "Service account for API calls made by the e2e tests (client credentials).",
      "enabled": true,
      "publicClient": false,
      "secret": "repody-e2e-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "repody-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "repody-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "repody-api",
      "name": "Repody API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "repody-admin",
      "name": "Repody admin area",
      "description": "Service account the Repody API uses to manage client groups and their users.",
      "enabled": true,
      "publicClient": false,
      "secret": "repody-admin-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["roles", "kc-admin-api"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "admin@repody.local",
      "firstName": "Platform",
      "lastName": "Admin",
      "email": "admin@repody.local",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "repody-dev",
          "temporary": false
        }
      ],
      "realmRoles": ["platform_admin"]
    },
    {
      "username": "operator@repody.local",
      "firstName": "Repody",
      "lastName": "Operator",
      "email": "operator@repody.local",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "repody-dev",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "viewer@repody.local",
      "firstName": "Repody",
      "lastName": "Viewer",
      "email": "viewer@repody.local",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "repody-dev",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    },
    {
      "username": "service-account-repody-e2e",
      "enabled": true,
      "serviceAccountClientId": "repody-e2e",
      "realmRoles": ["operator"]
    },
    {
      "username": "service-account-repody-admin",
      "enabled": true,
      "serviceAccountClientId": "repody-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "repody-web",
      "roles": ["platform_admin", "admin", "operator", "viewer"]
    },
    {
      "client": "repody-e2e",
      "roles": ["operator"]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "repody-admin",
        "roles": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    ]
  }
}
