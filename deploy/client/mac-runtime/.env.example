# Copy to .env (never commit secrets). Hub images — no application source.

REPODY_BACKEND_IMAGE=mehdigououiad/repody-backend:0.1.0
REPODY_WEB_IMAGE=mehdigououiad/repody-web:0.1.0
REPODY_PULL_POLICY=missing

# Data plane (public images)
REPODY_POSTGRES_IMAGE=postgres:17.10-alpine
REPODY_REDIS_IMAGE=redis:8.8.0-alpine
REPODY_MINIO_IMAGE=pgsty/minio:RELEASE.2026-06-18T00-00-00Z
REPODY_MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-04-17T00-00-00Z
REPODY_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.4

# Dev defaults — change before any non-localhost use
REPODY_POSTGRES_PASSWORD=audit-local-dev
REPODY_MINIO_USER=minioadmin
REPODY_MINIO_PASSWORD=minio-local-dev
REPODY_KEYCLOAK_ADMIN_USER=admin
REPODY_KEYCLOAK_ADMIN_PASSWORD=admin
AUTH_SECRET=local-dev-auth-secret-32chars-min!
AUTH_KEYCLOAK_CLIENT_SECRET=repody-web-dev-secret

# Must match LLAMACPP_MODEL_ALIAS in models/paths.env
AUDIT_LLAMACPP_SERVED_MODEL=nuextract3-q4_k_m
AUDIT_REPODY_VLM_ENABLED=true
AUDIT_SEED_ON_STARTUP=true
