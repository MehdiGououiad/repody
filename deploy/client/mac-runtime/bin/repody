#!/usr/bin/env bash
# Repody Mac runtime CLI - images + Compose only (no application source).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

COMPOSE=(docker compose --env-file .env -f compose.yaml)
PID_DIR="$ROOT/.pids"
LOG_DIR="$ROOT/logs"
PATHS_ENV="$ROOT/models/paths.env"

usage() {
  cat <<'EOF'
Repody Mac runtime (Docker Hub images — no source code)

Usage:
  ./bin/repody setup       Once: copy env files + docker pull
  ./bin/repody doctor      Preflight checks
  ./bin/repody start       Start NuExtract (host) + Compose stack
  ./bin/repody stop        Stop Compose + NuExtract
  ./bin/repody status      Container + health URLs
  ./bin/repody pull        Refresh Hub images
  ./bin/repody nuextract   Start host llama-server only
  ./bin/repody help

Sign-in (after start): http://localhost:3000
  operator@repody.local / repody-dev
  Use localhost (not 127.0.0.1).
EOF
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "error: Docker not found — install Docker Desktop for Mac" >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "error: Docker Desktop is not running" >&2
    exit 1
  fi
}

load_paths_env() {
  if [[ ! -f "$PATHS_ENV" ]]; then
    return 1
  fi
  # shellcheck disable=SC1090
  set -a
  # shellcheck disable=SC1091
  source "$PATHS_ENV"
  set +a
  return 0
}

infer_alias() {
  local model="${1:-}" explicit="${2:-}"
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
    return
  fi
  local base
  base="$(basename "$model" .gguf)"
  case "$base" in
    *Q8_0*|*q8_0*) echo "nuextract3-q8_0" ;;
    *Q6_K*|*q6_k*) echo "nuextract3-q6_k" ;;
    *Q4_K_M*|*q4_k_m*) echo "nuextract3-q4_k_m" ;;
    *) echo "nuextract3-q4_k_m" ;;
  esac
}

cmd_setup() {
  need_docker
  if [[ ! -f .env ]]; then
    cp .env.example .env
    echo "created .env"
  else
    echo ".env already present"
  fi
  if [[ ! -f "$PATHS_ENV" ]]; then
    cp models/paths.env.example "$PATHS_ENV"
    echo "created models/paths.env — edit LLAMACPP_MODEL and LLAMACPP_MMPROJ"
  else
    echo "models/paths.env already present"
  fi
  mkdir -p "$LOG_DIR" "$PID_DIR"
  echo "Pulling images…"
  # shellcheck disable=SC1091
  set -a && source .env && set +a
  docker pull "${REPODY_BACKEND_IMAGE:-mehdigououiad/repody-backend:0.2.0}"
  docker pull "${REPODY_WEB_IMAGE:-mehdigououiad/repody-web:0.2.0}"
  "${COMPOSE[@]}" pull
  echo
  echo "Next:"
  echo "  1) brew install llama.cpp"
  echo "  2) Download NuExtract3 GGUFs → edit models/paths.env"
  echo "  3) ./bin/repody doctor && ./bin/repody start"
}

cmd_doctor() {
  local ok=1
  echo "── Repody Mac runtime preflight ──"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo "ok   Docker Desktop"
  else
    echo "FAIL Docker Desktop"; ok=0
  fi
  if [[ -f .env ]]; then
    echo "ok   .env"
  else
    echo "FAIL .env — run ./bin/repody setup"; ok=0
  fi
  if command -v llama-server >/dev/null 2>&1; then
    echo "ok   llama-server ($(command -v llama-server))"
  else
    echo "FAIL llama-server — brew install llama.cpp"; ok=0
  fi
  if load_paths_env; then
    if [[ -n "${LLAMACPP_MODEL:-}" && -f "${LLAMACPP_MODEL}" ]]; then
      echo "ok   NuExtract model: $LLAMACPP_MODEL"
    else
      echo "FAIL LLAMACPP_MODEL missing or not a file"; ok=0
    fi
    if [[ -n "${LLAMACPP_MMPROJ:-}" && -f "${LLAMACPP_MMPROJ}" ]]; then
      echo "ok   mmproj: $LLAMACPP_MMPROJ"
    else
      echo "FAIL LLAMACPP_MMPROJ missing or not a file"; ok=0
    fi
  else
    echo "FAIL models/paths.env — run ./bin/repody setup"; ok=0
  fi
  if [[ -f .env ]]; then
    # shellcheck disable=SC1091
    set -a && source .env && set +a
    if docker image inspect "${REPODY_BACKEND_IMAGE:-mehdigououiad/repody-backend:0.2.0}" >/dev/null 2>&1; then
      echo "ok   backend image"
    else
      echo "warn backend image not local — ./bin/repody pull"
    fi
    if docker image inspect "${REPODY_WEB_IMAGE:-mehdigououiad/repody-web:0.2.0}" >/dev/null 2>&1; then
      echo "ok   web image"
    else
      echo "warn web image not local — ./bin/repody pull"
    fi
  fi
  echo
  if [[ "$ok" -eq 1 ]]; then
    echo "READY — ./bin/repody start"
    return 0
  fi
  echo "Not ready — fix FAIL lines above"
  return 1
}

nuextract_running() {
  local port="${LLAMACPP_PORT:-8081}"
  curl -sf "http://127.0.0.1:${port}/v1/models" >/dev/null 2>&1
}

cmd_nuextract() {
  if ! load_paths_env; then
    echo "error: missing models/paths.env — ./bin/repody setup" >&2
    exit 1
  fi
  local exe="${LLAMACPP_EXE:-}"
  if [[ -z "$exe" ]]; then
    exe="$(command -v llama-server || true)"
  fi
  if [[ -z "$exe" || ! -x "$exe" ]]; then
    echo "error: llama-server not found — brew install llama.cpp" >&2
    exit 1
  fi
  if [[ ! -f "${LLAMACPP_MODEL:-}" || ! -f "${LLAMACPP_MMPROJ:-}" ]]; then
    echo "error: set LLAMACPP_MODEL and LLAMACPP_MMPROJ in models/paths.env" >&2
    exit 1
  fi
  local port="${LLAMACPP_PORT:-8081}"
  local alias
  alias="$(infer_alias "$LLAMACPP_MODEL" "${LLAMACPP_MODEL_ALIAS:-}")"
  if nuextract_running; then
    echo "llama-server already on :$port"
    return 0
  fi
  mkdir -p "$LOG_DIR" "$PID_DIR"
  local args=(
    -m "$LLAMACPP_MODEL"
    --mmproj "$LLAMACPP_MMPROJ"
    --host 0.0.0.0
    --port "$port"
    -c "${LLAMACPP_CONTEXT:-32768}"
    -np "${LLAMACPP_PARALLEL:-1}"
    -a "$alias"
    --jinja
  )
  # Everything else is llama.cpp's default (image resolution, batch sizes, flash attention, offload).
  if [[ -n "${LLAMACPP_DEVICE:-}" ]]; then
    args+=(--device "$LLAMACPP_DEVICE")
  fi
  echo "Starting llama-server :$port ($alias)…"
  nohup "$exe" "${args[@]}" \
    >"$LOG_DIR/llama-server.out.log" \
    2>"$LOG_DIR/llama-server.err.log" &
  echo $! >"$PID_DIR/llama-server.pid"
  local i=0
  while (( i < 90 )); do
    if nuextract_running; then
      echo "llama-server ready — http://127.0.0.1:${port}/v1"
      return 0
    fi
    sleep 2
    i=$((i + 1))
  done
  echo "error: timed out — see $LOG_DIR/llama-server.err.log" >&2
  exit 1
}

stop_nuextract() {
  local port=8081
  if load_paths_env; then
    port="${LLAMACPP_PORT:-8081}"
  fi
  if [[ -f "$PID_DIR/llama-server.pid" ]]; then
    kill "$(cat "$PID_DIR/llama-server.pid")" 2>/dev/null || true
    rm -f "$PID_DIR/llama-server.pid"
  fi
  # Best-effort: free the port if something else holds it
  if command -v lsof >/dev/null 2>&1; then
    local pids
    pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "$pids" ]]; then
      # shellcheck disable=SC2086
      kill $pids 2>/dev/null || true
    fi
  fi
}

cmd_start() {
  need_docker
  if [[ ! -f .env ]]; then
    echo "error: run ./bin/repody setup first" >&2
    exit 1
  fi
  cmd_doctor
  if load_paths_env; then
    local alias
    alias="$(infer_alias "$LLAMACPP_MODEL" "${LLAMACPP_MODEL_ALIAS:-}")"
    # Keep Compose served-model in sync when possible
    if grep -q '^AUDIT_LLAMACPP_SERVED_MODEL=' .env; then
      sed -i.bak "s/^AUDIT_LLAMACPP_SERVED_MODEL=.*/AUDIT_LLAMACPP_SERVED_MODEL=${alias}/" .env
      rm -f .env.bak
    fi
  fi
  cmd_nuextract
  echo "Starting Compose…"
  "${COMPOSE[@]}" up -d --no-build
  echo
  echo "UI   http://localhost:3000"
  echo "API  http://localhost:8000/v1/healthz/live"
  echo "Login operator@repody.local / repody-dev  (use localhost, not 127.0.0.1)"
}

cmd_stop() {
  if [[ -f .env ]]; then
    "${COMPOSE[@]}" down --remove-orphans || true
  fi
  stop_nuextract
  echo "Stopped."
}

cmd_status() {
  if [[ -f .env ]]; then
    "${COMPOSE[@]}" ps || true
  fi
  if load_paths_env && nuextract_running; then
    echo "NuExtract: up :${LLAMACPP_PORT:-8081}"
  else
    echo "NuExtract: down"
  fi
  curl -sf http://127.0.0.1:8000/v1/healthz/live >/dev/null 2>&1 \
    && echo "API: healthy" || echo "API: not ready"
}

cmd_pull() {
  need_docker
  [[ -f .env ]] || cp .env.example .env
  # shellcheck disable=SC1091
  set -a && source .env && set +a
  docker pull "${REPODY_BACKEND_IMAGE:-mehdigououiad/repody-backend:0.2.0}"
  docker pull "${REPODY_WEB_IMAGE:-mehdigououiad/repody-web:0.2.0}"
  "${COMPOSE[@]}" pull
}

cmd="${1:-help}"
case "$cmd" in
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  pull) cmd_pull ;;
  nuextract) cmd_nuextract ;;
  help|-h|--help) usage ;;
  *) echo "Unknown: $cmd"; usage; exit 1 ;;
esac
