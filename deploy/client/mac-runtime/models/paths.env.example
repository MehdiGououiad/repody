# Copy to models/paths.env and set absolute paths to NuExtract3 GGUFs.
# Download: https://huggingface.co/numind/NuExtract3-GGUF
#
# Keep LLAMACPP_MODEL_ALIAS in sync with AUDIT_LLAMACPP_SERVED_MODEL in .env

LLAMACPP_EXE=
LLAMACPP_MODEL=/Users/YOU/Models/NuExtract3-Q4_K_M.gguf
LLAMACPP_MMPROJ=/Users/YOU/Models/mmproj-NuExtract3-BF16.gguf
LLAMACPP_MODEL_ALIAS=nuextract3-q4_k_m

LLAMACPP_PORT=8081
LLAMACPP_CONTEXT=32768
# Metal: leave empty (llama.cpp picks Metal on Apple Silicon)
LLAMACPP_DEVICE=
LLAMACPP_PARALLEL=1

# Only what NuExtract3 and llama.cpp need; image resolution, batch sizes, flash attention and
# GPU offload are llama.cpp's defaults (deploy/scripts/llama-serve.mjs).
