# Optional overrides for pnpm glmocr:serve (llama-server).
# Copy to deploy/glmocr/paths.local.env (not committed).
# Then: pnpm glmocr:serve && pnpm glmocr:verify

# GLMOCR_PORT=8083
# GLMOCR_MODEL_ALIAS=GLM-OCR
# GLMOCR_HF_QUANT=F16
# # Throughput on shared iGPU (slight quality tradeoff):
# # GLMOCR_HF_QUANT=Q8_0
# GLMOCR_CONTEXT=4096
# GLMOCR_PARALLEL=1
# GLMOCR_UBATCH_SIZE=512
# GLMOCR_IMAGE_MAX_TOKENS=1024
# GLMOCR_FLASH_ATTN=on
# GLMOCR_EXE=C:\path\to\llama-server.exe
# GLMOCR_DEVICE=Vulkan0
