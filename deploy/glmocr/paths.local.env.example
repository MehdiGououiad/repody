# Copy to deploy/glmocr/paths.local.env (not committed).
# Then: pnpm glmocr:serve && pnpm glmocr:verify

GLMOCR_EXE=
# Default: HF auto-download (llama-server -hf ggml-org/GLM-OCR-GGUF)
# GLMOCR_USE_HF=true
# GLMOCR_MODEL=C:\path\to\GLM-OCR-Q8_0.gguf
# GLMOCR_MMPROJ=C:\path\to\mmproj-model-f16.gguf
GLMOCR_MODEL_ALIAS=GLM-OCR

GLMOCR_PORT=8083
GLMOCR_CONTEXT=8192
GLMOCR_GPU_LAYERS=99
# GLMOCR_DEVICE=Vulkan0
GLMOCR_PARALLEL=1
