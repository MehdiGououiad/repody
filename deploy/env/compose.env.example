# Copy to backend/.env for local development (host API and worker, `pnpm platform dev`).
# Also copy deploy/env.auth.example to the repo-root .env.local (Next.js / Better Auth).
# Every AUDIT_* setting is in backend/src/repody/settings.py; see deploy/ENV.md.

AUDIT_DATABASE_URL=postgresql+asyncpg://audit:audit-local-dev@127.0.0.1:5432/repody
AUDIT_S3_ENDPOINT_URL=http://127.0.0.1:8333
AUDIT_S3_ACCESS_KEY=repody
AUDIT_S3_SECRET_KEY=s3-local-dev

# Hatchet Lite (Compose service; dashboard :8888). `pnpm platform` writes a new API token
# here on every start; the engine's addresses come from the token.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none
# Hatchet's database role in the local Postgres (read by compose.yaml): `pnpm platform`
# writes a random one here on the first start.
HATCHET_DB_PASSWORD=

# llama-server serving NuExtract on :8081 (deploy/llamacpp/README.md)
AUDIT_LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
AUDIT_LLAMACPP_SERVED_MODEL=nuextract3-q8_0
# CPU inference is slow: allow 10 minutes per model call and per run.
AUDIT_INFERENCE_TIMEOUT_SECONDS=600
AUDIT_RUN_TIMEOUT_MINUTES=10

# Keycloak (Compose service on :8080)
AUDIT_OIDC_ENABLED=true
AUDIT_OIDC_ISSUER=http://localhost:8080/realms/repody
AUDIT_OIDC_ISSUER_ALIASES=http://127.0.0.1:8080/realms/repody
AUDIT_OIDC_JWKS_URL=http://localhost:8080/realms/repody/protocol/openid-connect/certs
AUDIT_OIDC_AUDIENCE=repody-api

# Optional: OpenTelemetry agent and Bugsink (observability profile)
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# SENTRY_DSN=http://<key>@127.0.0.1:8090/<project-id>
