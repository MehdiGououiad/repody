# Repody on a VPS: copy to /opt/repody/.env on the server (chmod 600) and fill in every value.
# It never goes in git or CI. Secrets: `openssl rand -hex 32` (hex only: they end up in SQL,
# JSON and URLs). REPODY_VERSION is not here: each deploy writes it to release.env.

# The GHCR images (ghcr.io/<owner>).
REPODY_REGISTRY=ghcr.io/your-github-user

# Public hostnames, routed by the Cloudflare Tunnel.
APP_HOST=app.example.com
AUTH_HOST=auth.example.com
# Keycloak's admin console: keep it behind Cloudflare Access.
KEYCLOAK_ADMIN_HOST=kc-admin.example.com

# The Cloudflare Tunnel (Zero Trust -> Networks -> Connectors -> the tunnel's token).
CLOUDFLARE_TUNNEL_TOKEN=

# Databases and storage
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
HATCHET_DB_PASSWORD=
S3_SECRET_KEY=

# Sign-in (Better Auth + Keycloak)
AUTH_SECRET=
AUTH_KEYCLOAK_CLIENT_SECRET=
# The admin area's Keycloak service account (repody-admin): openssl rand -hex 32
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Cloudflare Turnstile's secret key for the site's access requests (Cloudflare > Turnstile >
# repody-access-requests). Empty: requests are accepted without the anti-robot check.
TURNSTILE_SECRET=
# The platform admin created on first start; must change the password and set up an
# authenticator app at first sign-in.
REPODY_ADMIN_EMAIL=you@example.com
REPODY_ADMIN_INITIAL_PASSWORD=
# Temporary Keycloak admin-console account (replace with a permanent one, then remove it).
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
# Hatchet's dashboard (README "Hatchet"); its admin is REPODY_ADMIN_EMAIL. Hatchet wants 8 to 64
# characters with an uppercase letter, a lowercase letter and a digit, or it creates no tenant
# (hatchet-token then fails): printf 'Rp%s9' "$(openssl rand -hex 28)"
HATCHET_ADMIN_PASSWORD=

# NuExtract3 on Modal (deploy/modal/README.md): the web function URL and Proxy Token (wk-….ws-…).
MODAL_URL=https://your-workspace--repody-nuextract-vllm-serve.us-east.modal.run
MODAL_PROXY_TOKEN=

# Optional
AUDIT_WORKER_CONCURRENCY=4
# Staging only (README "Staging"): leave these out on production, whose values are the defaults.
# COMPOSE_PROJECT_NAME=repody-staging
# DEPLOYMENT_ENVIRONMENT=staging
# HATCHET_DASHBOARD_PORT=8889
# ACCESS_REQUESTS_ENABLED=false
# CORS_ORIGINS=

# Errors on this server (README "Errors"): Bugsink, with the "errors" profile.
# COMPOSE_PROFILES=errors
# ERRORS_HOST=errors.example.com
# BUGSINK_SECRET_KEY=
# BUGSINK_DB_PASSWORD=
# BUGSINK_ADMIN_PASSWORD=
# The project's DSN on the stack network: http://<key>@bugsink:8000/1
BUGSINK_DSN=

# Brand (optional): one deployment per client. Colours are any CSS colour; the theme engine
# derives every surface, text and accent shade from them, light and dark, with contrast checks.
REPODY_BRAND_NAME=
REPODY_BRAND_LOGO_URL=
# The neutral: keep it near grey; its hue tints surfaces and text.
REPODY_BRAND_BASE=
# The one colour of the interface (primary action, focus, selection).
REPODY_BRAND_ACCENT=
# 30 (soft) to 100 (crisp).
REPODY_BRAND_CONTRAST=
# Corner radius of controls in px, 0 to 12.
REPODY_BRAND_RADIUS=
