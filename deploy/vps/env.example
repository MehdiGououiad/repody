# Repody on a VPS: copy to /opt/repody/.env on the server (chmod 600) and fill in every value.
# It never goes in git or CI. Secrets: `openssl rand -hex 32` (hex only: they end up in SQL,
# JSON and URLs). REPODY_VERSION is not here: each deploy writes it to release.env.

# The GHCR images (ghcr.io/<owner>).
REPODY_REGISTRY=ghcr.io/your-github-user

# Public hostnames, routed by the Cloudflare Tunnel.
APP_HOST=app.example.com
AUTH_HOST=auth.example.com
# Keycloak's admin console: keep it behind Cloudflare Access.
KEYCLOAK_ADMIN_HOST=kc-admin.example.com

# The Cloudflare Tunnel (Zero Trust -> Networks -> Connectors -> the tunnel's token).
CLOUDFLARE_TUNNEL_TOKEN=

# Databases and storage
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
S3_SECRET_KEY=

# Sign-in (Better Auth + Keycloak)
AUTH_SECRET=
AUTH_KEYCLOAK_CLIENT_SECRET=
# The platform admin created on first start; must change the password and set up an
# authenticator app at first sign-in.
REPODY_ADMIN_EMAIL=you@example.com
REPODY_ADMIN_INITIAL_PASSWORD=
# Temporary Keycloak admin-console account (replace with a permanent one, then remove it).
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=

# NuExtract3 on Modal (deploy/modal/README.md): the web function URL and Proxy Token (wk-….ws-…).
MODAL_URL=https://your-workspace--repody-nuextract-vllm-serve.us-east.modal.run
MODAL_PROXY_TOKEN=

# Optional
AUDIT_WORKER_CONCURRENCY=4
BUGSINK_DSN=
