# macOS Metal defaults — copy to deploy/llamacpp/paths.local.env
# Install once: brew install llama.cpp
# Then: pnpm llamacpp:serve   (optional — Mac portable default skips NuExtract)

LLAMACPP_EXE=
LLAMACPP_MODEL=
LLAMACPP_MMPROJ=
LLAMACPP_MODEL_ALIAS=nuextract3-q4_k_m

LLAMACPP_PORT=8081
LLAMACPP_CONTEXT=16384
LLAMACPP_GPU_LAYERS=99
# Leave empty — llama.cpp picks Metal on Apple Silicon
LLAMACPP_DEVICE=
LLAMACPP_PARALLEL=1

LLAMACPP_IMAGE_MIN_TOKENS=768
LLAMACPP_IMAGE_MAX_TOKENS=1024
LLAMACPP_FLASH_ATTN=on
LLAMACPP_WARMUP=off
