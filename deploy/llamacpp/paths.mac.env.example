# macOS Metal defaults - copy to deploy/llamacpp/paths.local.env
# Install once: brew install llama.cpp
# Required for default `pnpm platform` (catalog repody:vlm).
# Download GGUFs: https://huggingface.co/numind/NuExtract3-GGUF

LLAMACPP_EXE=
LLAMACPP_MODEL=
LLAMACPP_MMPROJ=
LLAMACPP_MODEL_ALIAS=nuextract3-q4_k_m

LLAMACPP_PORT=8081
LLAMACPP_CONTEXT=32768
# Leave empty - llama.cpp picks Metal on Apple Silicon
LLAMACPP_DEVICE=
LLAMACPP_PARALLEL=1

# Only what NuExtract3 and llama.cpp need; image resolution, batch sizes, flash attention and
# GPU offload are llama.cpp's defaults (deploy/scripts/llama-serve.mjs).
