# Copy to deploy/llamacpp/paths.local.env (not committed).
# Then: pnpm llamacpp:serve && pnpm llamacpp:verify
#
# Official sources:
#   https://huggingface.co/numind/NuExtract3-GGUF
#   https://github.com/ggml-org/llama.cpp/blob/master/docs/multimodal.md
#
# Keep LLAMACPP_MODEL_ALIAS in sync with AUDIT_LLAMACPP_SERVED_MODEL.

LLAMACPP_EXE=
LLAMACPP_MODEL=C:\path\to\NuExtract3-Q8_0.gguf
LLAMACPP_MMPROJ=C:\path\to\mmproj-NuExtract3-BF16.gguf
LLAMACPP_MODEL_ALIAS=nuextract3-q8_0

LLAMACPP_PORT=8081
LLAMACPP_CONTEXT=16384
LLAMACPP_GPU_LAYERS=99
LLAMACPP_DEVICE=Vulkan0
LLAMACPP_PARALLEL=1

# Qwen-VL accuracy floor. Deep bench on Arc: Q8 @ 1024 best overall/hard score;
# vision 1536+ unstable mid-suite. Keep max capped (unbounded → ErrorDeviceLost).
LLAMACPP_IMAGE_MIN_TOKENS=1024
LLAMACPP_IMAGE_MAX_TOKENS=1024
LLAMACPP_UBATCH_SIZE=1024
LLAMACPP_MTMD_BATCH_MAX_TOKENS=1024

LLAMACPP_FLASH_ATTN=on
LLAMACPP_WARMUP=off
