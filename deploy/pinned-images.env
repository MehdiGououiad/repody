# Pinned local/dev container image tags.
# Enterprise production uses client-managed data, queue, auth, observability, and inference services.
# See docs/DEVELOPMENT.md#pinned-versions.

# Local/dev data plane
REPODY_POSTGRES_IMAGE=postgres:17.11-alpine
REPODY_REDIS_IMAGE=redis:8.8.3-alpine
REPODY_MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
REPODY_MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# Local/dev auth
REPODY_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4

# Local/dev observability
REPODY_LOKI_IMAGE=grafana/loki:3.7.8
REPODY_PROMTAIL_IMAGE=grafana/promtail:3.6.11
REPODY_GRAFANA_IMAGE=grafana/grafana:13.0.9
REPODY_TEMPO_IMAGE=grafana/tempo:2.10.8
REPODY_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
REPODY_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.161.0

# Local/dev Sentry-compatible error tracking
REPODY_BUGSINK_IMAGE=bugsink/bugsink:2

# Local/dev edge
REPODY_CADDY_IMAGE=caddy:2.11.4-alpine

# K8s local bootstrap utilities
REPODY_BUSYBOX_IMAGE=busybox:1.37.0
REPODY_KUBECTL_IMAGE=dtzar/helm-kubectl:3.19.1
