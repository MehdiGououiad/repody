# syntax=docker/dockerfile:1
# Built by docker-bake.hcl (`bun run images:build`). Backend origin and Bugsink server DSN are
# runtime env (INTERNAL_API_URL / BACKEND_URL / BUGSINK_DSN), never build args.
# Bun installs the dependencies and runs the build script; Node runs Next.js, here and in the
# runner. The pinned Bun binary comes from Bun's own image (musl, for Alpine).
FROM oven/bun:1.4.5-alpine@sha256:da816670775f4c2b4e990b6b1847cf5540dcdc721a42033dd331ce7a88ba6a3b AS bun

FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY package.json bun.lock bunfig.toml ./
RUN --mount=type=cache,id=bun-install,target=/root/.bun/install/cache     bun install --frozen-lockfile --ignore-scripts

FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
ARG NEXT_PUBLIC_BUGSINK_DSN=
ENV NEXT_PUBLIC_BUGSINK_DSN=${NEXT_PUBLIC_BUGSINK_DSN}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# npm ships brace-expansion, tar, ip-address, and undici. The server only needs node.
RUN apk upgrade --no-cache \
  && apk add --no-cache libc6-compat \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && addgroup -g 10001 -S repody \
  && adduser -u 10001 -S -G repody -H -s /sbin/nologin repody
# Listen on every interface (Next.js standalone binds to $HOSTNAME, which Docker sets to the
# container id): probes and port mappings reach it.
ENV PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=builder --chown=10001:10001 /app/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/.next/static ./.next/static
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
