# syntax=docker/dockerfile:1.7
FROM node:24-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM node:24-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
# Build-time placeholders only — runtime proxy uses INTERNAL_API_URL / BACKEND_URL
# from the container env (Compose: http://api:8000, K8s: http://repody-api:8000).
ARG BACKEND_URL=http://127.0.0.1:8000
ARG NEXT_PUBLIC_BUGSINK_DSN=
ARG BUGSINK_DSN=
ENV BACKEND_URL=${BACKEND_URL}
ENV INTERNAL_API_URL=${BACKEND_URL}
ENV NEXT_PUBLIC_BUGSINK_DSN=${NEXT_PUBLIC_BUGSINK_DSN}
ENV BUGSINK_DSN=${BUGSINK_DSN}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat \
  && addgroup -g 10001 -S repody \
  && adduser -u 10001 -S -G repody -H -s /sbin/nologin repody
ENV PORT=3000
COPY --from=builder --chown=10001:10001 /app/public ./public
COPY --from=builder --chown=10001:10001 /app/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/.next/static ./.next/static
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
